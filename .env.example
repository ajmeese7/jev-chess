# Vercel AI Gateway key (vck_...). Required locally and in production.
AI_GATEWAY_API_KEY=

# Upstash Redis for per-IP rate limiting. Required in production unless RATE_LIMIT=off.
# The Vercel Marketplace Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both names are accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT=off
